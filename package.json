{
  "name": "lycwl-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "test": "node --test tests/**/*.test.ts",
    "test:unit": "node --test tests/unit/**/*.test.ts",
    "test:contract": "node --test tests/contract/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.0.8"
  }
}
