# Local reference material, not an application source artifact.
AGENTS.md

# Working notes, review records and stage plans stay local; the decision records
# under docs/adr are the durable output and are tracked below.
docs/*
!docs/adr/

# Installed dependencies and tool caches.
node_modules/
.pnpm-store/
coverage/
biome-cache/
release/

# dist/ is committed on purpose: a git dependency does not install
# devDependencies, so `prepare` cannot run tsc, and `npm install -g github:...`
# would otherwise install a package with no runnable entry. tools/check-dist-fresh.mjs
# fails the build when the output is older than the source.

# Local runtime data.
.tmp/
*.log
