{
  "name": "lycwl-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "bin": {
    "lycwl": "./src/bootstrap/main.ts"
  },
  "scripts": {
    "start": "node src/bootstrap/main.ts",
    "test": "node --test tests/**/*.test.ts",
    "test:unit": "node --test tests/unit/**/*.test.ts",
    "test:contract": "node --test tests/contract/**/*.test.ts",
    "test:architecture": "node --test tests/contract/architecture.test.ts",
    "test:tui": "vitest run tests/unit/tui-render.test.ts tests/unit/setup-screen-render.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:tests-present": "node tools/require-tests.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run check:tests-present && pnpm run test:architecture && pnpm run test && pnpm run test:tui"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0",
    "typescript": "5.9.3",
    "vitest": "4.0.8"
  },
  "dependencies": {
    "ink": "8.0.0",
    "koffi": "3.3.4",
    "react": "19.3.1"
  }
}
